APP_ENV=development
APP_VERSION=0.1.0
DATABASE_URL=sqlite:///./data/cinema.db
LOG_LEVEL=INFO
# Generate a private value: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=30
RATING_WEIGHTS={"idea":1,"plot":1,"screenplay":1,"acting":1,"sound":1,"visuals":1}
# Optional: without a key, saved movies and club feedback still work.
KINOPOISK_API_KEY=
EXTERNAL_CACHE_TTL_SECONDS=86400
# Local test SMTP, e.g. Mailpit. Empty credentials are allowed locally.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=cinema-club@example.org
SMTP_TLS=false
